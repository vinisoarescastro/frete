# Copie para .env e preencha. O arquivo .env nunca deve ir para o git.

# Senha de acesso ao site (obrigatória; use algo longo)
APP_PASSWORD=troque-esta-senha

# Chave do navegador (Maps JavaScript API). Restrinja por "Referenciadores HTTP" ao seu domínio.
GOOGLE_MAPS_BROWSER_KEY=
# Chave do servidor (Geocoding API + Routes API). Restrinja por IP da VPS. Não pode ser a mesma restrita por referenciador.
GOOGLE_MAPS_SERVER_KEY=
# Opcional: ID de mapa (Map ID) criado no Google Cloud. DEMO_MAP_ID funciona para testes.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Rede
PORT=3000
HOST=127.0.0.1
# Use true quando estiver atrás de Nginx/Caddy (lê X-Forwarded-For e X-Forwarded-Proto)
TRUST_PROXY=false
# Duração do login, em dias
SESSION_DAYS=7
