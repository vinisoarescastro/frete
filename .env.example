# Copie para .env e preencha. O arquivo .env nunca deve ir para o git.

# Senha de acesso ao site (obrigatória; use algo longo)
APP_PASSWORD=troque-esta-senha

# Recomendado: chave gratuita do Geoapify (myprojects.geoapify.com) para endereços e rotas.
# Sem ela, o servidor usa os serviços públicos do OpenStreetMap (Nominatim e OSRM), que podem falhar.
GEOAPIFY_KEY=

# Opcional (só no modo sem chave): e-mail de contato enviado ao Nominatim no User-Agent (a política do OpenStreetMap recomenda)
NOMINATIM_CONTACT=

# Arquivo do banco de dados (SQLite). Faça backup deste arquivo.
# DB_PATH=./data/frete.db

# Rede
PORT=3000
HOST=127.0.0.1
# Use true quando estiver atrás de Nginx/Caddy (lê X-Forwarded-For e X-Forwarded-Proto)
TRUST_PROXY=false
# Duração do login, em dias
SESSION_DAYS=7
